# Portal TC Surabaya — salin file ini menjadi .env.local dan isi nilainya.
# JANGAN pernah commit file .env.local ke Git.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kunci enkripsi kolom akun_pintar (pgcrypto) — buat string acak panjang
AKUN_PINTAR_ENCRYPTION_KEY=

# Fonnte (Reminder WhatsApp)
FONNTE_TOKEN=

# Sinkronisasi Google Spreadsheet
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
